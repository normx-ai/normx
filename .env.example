# NormX - Variables d'environnement
# Copier en .env et adapter. Les valeurs sont validees au boot du serveur.

# ===== Runtime =====
NODE_ENV=development
PORT=5002
LOG_LEVEL=info

# ===== Database =====
# Soit DATABASE_URL :
# DATABASE_URL=postgres://normx:secret@localhost:5434/normx_db
# Soit DB_HOST + DB_NAME + DB_USER (+ DB_PASSWORD recommande) :
DB_HOST=localhost
DB_PORT=5434
DB_NAME=normx_db
DB_USER=normx
DB_PASSWORD=changeme
DB_POOL_MAX=50
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ===== CORS (CSV) =====
ALLOWED_ORIGINS=http://localhost:3001,https://normx-ai.com

# ===== Auth Keycloak =====
KEYCLOAK_URL=https://auth.normx-ai.com
KEYCLOAK_REALM=normx
KEYCLOAK_CLIENT_ID=normx-frontend

# ===== Crypto (chiffrement champs sensibles) =====
# Generer avec : openssl rand -hex 32
ENCRYPTION_KEY=replace_with_at_least_32_chars_random_string

# ===== IA Anthropic (optionnel : sans cle, /api/assistant et /api/ocr-import retournent 503) =====
ANTHROPIC_API_KEY=sk-ant-...

# ===== Qdrant (optionnel : recherche vectorielle KB) =====
QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT_MS=5000

# ===== Boot flags =====
# Applique automatiquement les migrations versionnees a tous les tenants au boot.
# Recommande en dev/staging, deconseille en prod (preferer un job CI/CD).
AUTO_MIGRATE_TENANTS=false
